        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
        filter: url('#blob-goo');
        /* Fade out/in as the blob leaves or returns to the home page; the
           scale shrink is driven in JS (blobScaleTarget → 0). */
        transition: opacity var(--blob-fade-dur) var(--ease);
