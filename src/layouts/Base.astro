        transform-origin: 0 0;
        transform: translate3d(-50%, -50%, 0);
        /* Ease the tint when a card hover swaps --blob-color. */
        transition: background var(--cs-dur-color) var(--cs-ease-color);
        will-change: transform;
      }
      .blob--1 { width: var(--blob-size-1); height: var(--blob-size-1); }
      .blob--2 { width: var(--blob-size-2); height: var(--blob-size-2); }
      .blob--3 { width: var(--blob-size-3); height: var(--blob-size-3); }
      .blob--4 { width: var(--blob-size-4); height: var(--blob-size-4); }
      .blob--5 { width: var(--blob-size-5); height: var(--blob-size-5); }

