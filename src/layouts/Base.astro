        display: inline-block;
        opacity: 0;
        transform: translateY(var(--sr-travel));
        transition: opacity var(--sr-dur) var(--sr-ease),
                    transform var(--sr-dur) var(--sr-ease);
        transition-delay: calc(var(--sr-base, 0ms) + var(--sr-step) * var(--i, 0));
        will-change: opacity, transform;
      }
      .split-text.sr-in .sr-w { opacity: 1; transform: translateY(0); }
      @media (prefers-reduced-motion: reduce) {
        .split-text { opacity: 1; }
        .sr-w { opacity: 1; transform: none; transition: none; }
      }

      /* Responsive — swap desktop pill for mobile bar */
      @media (max-width: 768px) {
        .header { display: none !important; }
        .mobile-header { display: block; }

        footer.site-footer {
          width: 100%;
          grid-template-columns: 1fr;
          gap: 16px;
          padding: 32px 16px 40px;
          margin-top: 64px;
        }
        footer.site-footer .copy { grid-column: 1 / -1; }
        footer.site-footer .links { grid-column: 1 / -1; justify-content: flex-start; flex-wrap: wrap; gap: 12px; }
      }
      @media (max-width: 720px) {
        .menu .mb-extra { display: none; }
      }
    </style>
  </body>
</html>
