---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import '../styles/home.css';

// Display order: TWE → HASTE → Relate → Trier
const caseStudies = [
  {
    slug: 'treasury-wine-estates',
    theme: 'treasury' as const,
    icon: 1,
    cardName: 'Treasury Wine Estates',
    year: '2023',
    readTime: '5 min read',
    short:
      'A multi-brand design system for ten wine brands and one global parent on a shared architecture.',
  },
  {
    slug: 'haste',
    theme: 'haste' as const,
    icon: 3,
    cardName: 'HASTE',
    year: '2024',
    readTime: '4 min read',
    short:
      'A tokenized design system and methodology for igniting new client projects from a shared start.',
  },
  {
    slug: 'relate',
    theme: 'relate' as const,
    icon: 2,
    cardName: 'Relate',
    year: '2025',
    readTime: '3 min read',
    short:
      'Rebrand and redesign of an enterprise AI product across identity, system, product, and site.',
  },
  {
    slug: 'trier',
    theme: 'trier' as const,
    icon: 4,
    cardName: 'Trier',
    year: '2023',
    readTime: '4 min read',
    short:
      'A digital triage platform that cut ambulance ramping by 50% in the pilot hospital.',
  },
];

// Highlights gallery — wide desktop image + taller mobile image per item.
// Captions are placeholders for now.
const highlights = [
  {
    slug: 'barwise',
    name: 'BarWise',
    caption: 'BarWise is a mobile learning platform designed to help aspiring lawyers prepare for the bar exam through structured study materials, flashcards, and practice content. I led the project end-to-end, creating the brand identity, product strategy, user flows, interactions, and complete mobile experience. (2020)',
  },
  {
    slug: 'lt-reach',
    name: 'LiveTiles Reach',
    caption: 'LiveTiles Reach is an enterprise employee communication platform designed to help organizations share news, resources, and updates at scale. I led the redesign of key product experiences, including onboarding, dashboards, content consumption, and social interactions, making it easier for employees to discover information and connect with colleagues. (2022)',
  },
  {
    slug: 'flypgs',
    name: 'Pegasus Airlines',
    caption: 'Pegasus Airlines is one of Turkey’s leading low-cost carriers. Over an eighteen-month engagement, I designed the airline’s official website, while also leading the design and art direction of the inflight menu system used across domestic and international routes. (2017)',
  },
  {
    slug: 'hope-and-abel',
    name: 'Hope & Abel',
    caption: 'Hope & Abel is an AI-powered healthcare concept designed to support people living with chronic pain. The experience adapts to each user’s situation, recommending exercises, educational content, and wellbeing activities to help them build healthier habits and manage their condition more effectively. (2022)',
  },
  {
    slug: 'chatmycoach',
    name: 'Chat My Coach',
    caption: 'Chat My Coach is a digital therapy and coaching platform that connects users with professionals through text, voice, and video sessions. I created the product from the ground up, including the brand identity, user experience, design system, and complete mobile application. (2018)',
  },
  {
    slug: 'studio',
    name: 'Studio+',
    caption: 'Studio+ is an online learning platform focused on yoga, meditation, fitness, and personal wellbeing. I redesigned the entire mobile experience, simplifying navigation, improving content discovery, and creating a more intuitive way for users to find and engage with courses. (2019)',
  },
];
---

<Base>
  <section class="home-hero">
    <h1 class="split-text">Brand-led design systems for products and platforms.</h1>
    <p class="split-text">I'm Onur. Twenty years across brand, product, and interaction design. I design the layer where brand becomes architecture.</p>
  </section>

  <div class="section-divider reveal" data-delay="3"></div>
  <div class="section-label reveal" data-delay="4">
    <span>CASE&nbsp;&nbsp;STUDIES</span>
  </div>

  <div class="cs-section">
    <div class="cs-cards">
      {caseStudies.map((cs, i) => (
        <CaseStudyCard
          slug={cs.slug}
          theme={cs.theme}
          icon={cs.icon}
          cardName={cs.cardName}
          year={cs.year}
          short={cs.short}
          readTime={cs.readTime}
          slotIndex={i + 1}
        />
      ))}
    </div>
  </div>

  <div class="section-divider reveal"></div>
  <div class="section-label reveal highlights-label">
    <span>HIGHLIGHTS&nbsp;&nbsp;2017&nbsp;–&nbsp;2023</span>
  </div>

  <section class="highlights-section">
    <div class="highlights">
      {highlights.map((h) => (
        <figure class="highlight reveal">
          <picture class="highlight__media">
            <source media="(max-width: 768px)" srcset={`/assets/highlights/${h.slug}-mobile.png`} />
            <img
              src={`/assets/highlights/${h.slug}.png`}
              alt={h.name}
              loading="lazy"
              decoding="async"
              class="highlight__img"
            />
          </picture>
          <figcaption class="highlight__caption">{h.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>
