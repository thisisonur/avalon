---
import Base from '../layouts/Base.astro';
import '../styles/about.css';

const principles = [
  {
    icon: 'hiw-icon-figma',
    t: 'Brand intent, encoded into the system',
    d: 'Most systems treat brand as a surface layer. I work the other way around. Brand is the decision-making framework, and I translate that intent into token architecture so every choice is brand-aligned by default, not a guess.',
  },
  {
    icon: 'hiw-icon-second',
    t: 'Designed for the people who build with it',
    d: 'A design system only works if the team can actually use it. Adoption is part of the design problem, not a thing that comes after. Documentation, naming conventions, training, the operational model itself, all of it gets scoped together. The system gets built in the overlap between designers and engineers, and it lives or dies based on whether the people using it can move with confidence.',
  },
  {
    icon: 'hiw-icon-third',
    t: 'Documentation is the interface',
    d: "Naming conventions, token structure, accessibility, decision rationale, these are what let teams move fast without breaking things. Good documentation isn't a wrapper around the system; it's part of the system. And it isn't just for humans anymore. It's the interface between your system and every AI agent that will touch it.",
  },
];

const tools = [
  { name: 'Figma',       logo: '/assets/icons/tool-figma.svg' },
  { name: 'Claude',      logo: '/assets/icons/tool-claude.svg' },
  { name: 'Slack',       logo: '/assets/icons/tool-slack.svg' },
  { name: 'Jira',        logo: '/assets/icons/tool-jira.svg' },
  { name: 'Storybook',   logo: '/assets/icons/tool-storybook.svg' },
  { name: 'Chromatic',   logo: '/assets/icons/tool-chromatic.svg' },
  { name: 'Miro',        logo: '/assets/icons/tool-miro.svg' },
  { name: 'Obsidian',    logo: '/assets/icons/tool-obsidian.svg' },
  { name: 'Photoshop',   logo: '/assets/icons/tool-photoshop.svg' },
  { name: 'InDesign',    logo: '/assets/icons/tool-indesign.svg' },
  { name: 'Illustrator', logo: '/assets/icons/tool-illustrator.svg' },
];
const TOOL_DELAYS_MS = [0, 60, 140, 80, 220, 40, 300, 110, 180, 30, 260, 90, 200, 50, 320, 130];

const photos = [
  { src: '/assets/off-the-clock/cooking.png', alt: 'A plated dish — duck with roasted delicata squash and red couscous', caption: 'Beetroot couscous risotto with preserved lemon chicken thighs and pumpkin. Plated like I had something to prove.' },
  { src: '/assets/off-the-clock/billie.png', alt: 'Billie, our rescue pit bull, wearing a small viking helmet on the couch', caption: 'Billie as a viking. The sweetest dog alive, tolerating me.' },
  { src: '/assets/off-the-clock/diablo.png', alt: 'A Diablo character — a blindfolded rogue in grey leathers', caption: 'The Rogue from Diablo. Not my class, just my favorite to look at.' },
];
---

<Base title="About — Onur Erdem">
  <main class="about-main">
    <section class="ab-grid ab-hero">
      <div class="ab-hero__photo reveal">
        <div class="ab-hero__photo-img" role="img" aria-label="Profile photo"></div>
      </div>

      <div class="ab-hero__text">
        <h1 class="ab-hero__hi split-text">Hi!</h1>
        <div class="ab-hero__body split-text">
          <p>I've worked for 20+ years across brand, product, and UI design. The common thread has always been translation, turning what a brand means into how a product looks and behaves. That work taught me something: brand isn't a layer you add at the end. It's the framework that every other decision comes from.</p>
          <p>I've also built brands from scratch, naming, identity, voice. So when I design a system, I know what brand intent looks like before it becomes a token. The tokens aren't just variables. They carry that intent into the product.</p>
          <p>Today I focus on multi-brand and AI-product systems, where the brand-to-system translation matters most. Architectures that match their operational context, scoped to the team that has to maintain them, designed to let each brand stay itself even as the system holds them together.</p>
        </div>
      </div>
    </section>

    <hr class="ab-rule" />

    <section class="ab-grid ab-section ab-howiwork">
      <div class="ab-section__label-wrap">
        <div class="ab-label reveal">H O W &nbsp;&nbsp; I &nbsp;&nbsp; W O R K</div>
      </div>
      <div class="ab-principles">
        {principles.map((p, i) => (
          <div class="ab-principle reveal" data-delay={(i % 3) + 1}>
            <div class="ab-principle__icon">
              <img src={`/assets/icons/${p.icon}.svg`} alt="" width="56" height="56" />
            </div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="ab-rule" />

    <section class="ab-grid ab-section ab-toolkit">
      <div class="ab-section__label-wrap">
        <div class="ab-label reveal">T O O L K I T</div>
      </div>
      <h2 class="ab-hero__hi reveal" style="grid-column: 1 / -1; margin-top: -32px; margin-bottom: 40px;">
        Tools change. The thinking doesn't.
      </h2>
      <p class="ab-toolkit__intro reveal">The list shifts depending on the project. I pick up new tools quickly and stay close to what's changing in AI.</p>
      <div class="ab-tools">
        {tools.map((t, i) => (
          <div class="ab-tool reveal" style={`transition-delay: ${TOOL_DELAYS_MS[i % TOOL_DELAYS_MS.length]}ms`}>
            <img src={t.logo} alt={t.name} class="ab-tool__logo" />
            <div class="ab-tool__name">{t.name}</div>
          </div>
        ))}
      </div>
    </section>

    <hr class="ab-rule" />

    <section class="ab-grid ab-section ab-offclock">
      <div class="ab-section__label-wrap">
        <div class="ab-label reveal">O F F &nbsp;&nbsp; T H E &nbsp;&nbsp; C L O C K</div>
      </div>
      <h2 class="ab-hero__hi reveal" style="grid-column: 1 / -1; margin-top: -32px; margin-bottom: 40px;">
        Still iterating, just on dinner.
      </h2>
      <div class="ab-offclock__copy reveal">
        <p>Off the clock, I make ice cream in flavors that confuse people, roll pasta dough by hand, and chase whatever recipe sits between traditional and slightly unhinged. Weekends belong to Billie, our rescue pit bull, the sweetest dog alive and still a work in progress on some things. And I've been playing Diablo since it was pixelated on a slow PC. My Xbox wrap-up tells on me every year.</p>
      </div>
      <div class="ab-offclock__photos">
        {photos.map((p, i) => (
          <div class="ab-offclock__photo reveal" data-delay={(i % 3) + 1}>
            <figure class="ab-offclock__figure">
              <img src={p.src} alt={p.alt} class="ph ph--photo" loading="lazy" />
              <figcaption class="img-caption ab-offclock__caption">{p.caption}</figcaption>
            </figure>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>
